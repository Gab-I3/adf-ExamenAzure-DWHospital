{
	"name": "df_silver_billing",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_billing_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_billing_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(amount = toDecimal(regex_replace(amount, '[\\\\$,]', ''), 10, 2),",
				"          payment_status = iif(isNull(payment_status), 'unknown', lower(trim(payment_status))),",
				"          billing_id = toInteger(billing_id),",
				"          admission_id = toInteger(admission_id)) ~> derivedColumn1",
				"derivedColumn1 derive(payment_date = coalesce(\r",
				"    toDate(payment_date, 'MM-dd-yy'),\r",
				"    toDate(payment_date, 'MM/dd/yyyy'),\r",
				"    toDate(payment_date, 'yyyy-MM-dd'),\r",
				"    toDate(payment_date, 'dd-MMM-yyyy'),\r",
				"    toDate(payment_date, 'MMMM dd, yyyy')\r",
				")) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          billing_id,",
				"          admission_id,",
				"          charge_type,",
				"          amount,",
				"          payment_status,",
				"          payment_date",
				"     )) ~> sink1"
			]
		}
	}
}