{
	"name": "df_gold_dim_paciente",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "silver_patients_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "gold_dim_paciente_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(nombre_completo = toString(full_name),",
				"          genero = case(\r",
				"    upper(gender) == 'M' || upper(gender) == 'MALE' || upper(gender) == 'MASCULINO', 'Masculino',\r",
				"    upper(gender) == 'F' || upper(gender) == 'FEMALE' || upper(gender) == 'FEMENINO', 'Femenino',\r",
				"    'Otro'\r",
				"),",
				"          rango_etario = case(\r",
				"    year(currentTimestamp()) - year(date_of_birth) <= 18, '0-18',\r",
				"    year(currentTimestamp()) - year(date_of_birth) <= 35, '19-35',\r",
				"    year(currentTimestamp()) - year(date_of_birth) <= 60, '36-60',\r",
				"    '60+'\r",
				")) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          paciente_key as integer,",
				"          patient_id_bk as integer,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          rango_etario as string,",
				"          correo_electronico as string,",
				"          direccion as string,",
				"          proveedor_seguro as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id_bk = patient_id,",
				"          nombre_completo,",
				"          genero,",
				"          fecha_nacimiento = date_of_birth,",
				"          rango_etario,",
				"          correo_electronico = email,",
				"          direccion = address,",
				"          proveedor_seguro = insurance_provider",
				"     )) ~> sink1"
			]
		}
	}
}