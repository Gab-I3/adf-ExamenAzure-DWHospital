{
	"name": "df_silver_diagnoses",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_diagnoses_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_diagnoses_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          diagnosis_id as string,",
				"          admission_id as string,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"derivedColumn2 derive(icd_code = toString(\r",
				"    map(\r",
				"        split(replace(regex_replace(trim(upper(icd_code)), '\\\\s*,\\\\s*', ','), '-', '.'), ','),\r",
				"        iif(length(#item) > 3 && locate('.', #item) == 0, \r",
				"            substring(#item, 1, 3) + '.' + substring(#item, 4, length(#item)-3), \r",
				"            #item\r",
				"        )\r",
				"    )\r",
				"),",
				"          severity = iif(isNull(severity), 'Unknown', initCap(trim(severity))),",
				"          diagnosis_description = trim(diagnosis_description)) ~> derivedColumn1",
				"source1 derive(diagnosis_id = toInteger(diagnosis_id),",
				"          admission_id = toInteger(admission_id)) ~> derivedColumn2",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          diagnosis_id as integer,",
				"          admission_id as integer,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          diagnosis_id,",
				"          admission_id,",
				"          icd_code,",
				"          diagnosis_description,",
				"          severity",
				"     )) ~> sink1"
			]
		}
	}
}