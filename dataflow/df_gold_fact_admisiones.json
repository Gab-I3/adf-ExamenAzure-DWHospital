{
	"name": "df_gold_fact_admisiones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "silver_admissions_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "silver_diagnoses_sql",
						"type": "DatasetReference"
					},
					"name": "source2"
				},
				{
					"dataset": {
						"referenceName": "gold_dim_paciente_sql",
						"type": "DatasetReference"
					},
					"name": "source3"
				},
				{
					"dataset": {
						"referenceName": "gold_dim_departamento_sql",
						"type": "DatasetReference"
					},
					"name": "source4"
				},
				{
					"dataset": {
						"referenceName": "gold_dim_diagnostico_sql",
						"type": "DatasetReference"
					},
					"name": "source5"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "gold_fact_admisiones_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "lookup1"
				},
				{
					"name": "lookup2"
				},
				{
					"name": "lookup3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          diagnosis_id as integer,",
				"          admission_id as integer,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source(output(",
				"          paciente_key as integer,",
				"          patient_id_bk as integer,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          rango_etario as string,",
				"          correo_electronico as string,",
				"          direccion as string,",
				"          proveedor_seguro as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source3",
				"source(output(",
				"          departamento_key as integer,",
				"          nombre_departamento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source4",
				"source(output(",
				"          diagnostico_key as integer,",
				"          codigo_icd as string,",
				"          descripcion_patologia as string,",
				"          nivel_severidad as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source5",
				"source1, source2 join(source1@admission_id == source2@admission_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 derive(dias_estancia = toInteger(discharge_date - admission_date),",
				"          conteo_admisiones = 1,",
				"          fecha_ingreso_key = toInteger(toString(admission_date, 'yyyyMMdd')),",
				"          fecha_alta_key = iif(isNull(discharge_date), toInteger(null()), toInteger(toString(discharge_date, 'yyyyMMdd'))),",
				"          departamento = case(\r",
				"    upper(department) == 'CARDIOLOGY', 'Cardiología',\r",
				"    upper(department) == 'NEUROLOGY', 'Neurología',\r",
				"    upper(department) == 'ONCOLOGY', 'Oncología',\r",
				"    upper(department) == 'PEDIATRICS', 'Pediatría',\r",
				"    upper(department) == 'EMERGENCY', 'Emergencias',\r",
				"    upper(department) == 'SURGERY', 'Cirugía',\r",
				"    upper(department) == 'ORTHOPEDICS', 'Ortopedia',\r",
				"    upper(department) == 'GYNECOLOGY', 'Ginecología',\r",
				"    upper(department) == 'INTENSIVE CARE' || upper(department) == 'ICU', 'Cuidados Intensivos',\r",
				"    upper(department) == 'GENERAL SURGERY', 'Cirugia General',\r",
				"    upper(department) == 'RADIOLOGY', 'Radiología',\r",
				"    department\r",
				")) ~> derivedColumn1",
				"derivedColumn1, source3 lookup(patient_id == patient_id_bk,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1, source4 lookup(departamento == nombre_departamento,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup2",
				"lookup2, source5 lookup(icd_code == codigo_icd,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup3",
				"lookup3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admision_key as long,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          diagnostico_key as integer,",
				"          fecha_ingreso_key as integer,",
				"          fecha_alta_key as integer,",
				"          medico_id as integer,",
				"          dias_estancia as integer,",
				"          conteo_admisiones as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          admission_id_bk = source1@admission_id,",
				"          paciente_key,",
				"          departamento_key,",
				"          diagnostico_key,",
				"          fecha_ingreso_key,",
				"          fecha_alta_key,",
				"          medico_id = attending_doctor_id,",
				"          dias_estancia,",
				"          conteo_admisiones",
				"     )) ~> sink1"
			]
		}
	}
}