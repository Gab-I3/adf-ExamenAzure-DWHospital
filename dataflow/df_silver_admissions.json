{
	"name": "df_silver_admissions",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_admissions_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_admissions_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(department = case(\r",
				"    rlike(lower(department), '.*onco.*'), 'Oncology',\r",
				"    rlike(lower(department), '.*cardio.*'), 'Cardiology',\r",
				"    rlike(lower(department), '.*emerg.*|^er$'), 'Emergency',\r",
				"    rlike(lower(department), '.*ped.*|.*paed.*'), 'Pediatrics',\r",
				"    rlike(lower(department), '.*surg.*'), 'General Surgery',\r",
				"    rlike(lower(department), '.*neuro.*|.*nuer.*'), 'Neurology',\r",
				"    rlike(lower(department), '.*ortho.*'), 'Orthopedics',\r",
				"    initCap(trim(department))\r",
				"),",
				"          admission_id = toInteger(patient_id),",
				"          patient_id = toInteger(patient_id),",
				"          attending_doctor_id = toInteger(attending_doctor_id)) ~> derivedColumn1",
				"derivedColumn1 derive(admission_date = coalesce(\r",
				"    toDate(admission_date, 'MM-dd-yy'), \r",
				"    toDate(admission_date, 'dd-MMM-yyyy'), \r",
				"    toDate(admission_date, 'yyyy-MM-dd'),\r",
				"    toDate(admission_date, 'MM/dd/yyyy'),\r",
				"    toDate(admission_date, 'MMMM dd, yyyy'),\r",
				"    toDate('1900-01-01')\r",
				"),",
				"          discharge_date = coalesce(\r",
				"    toDate(discharge_date, 'MM-dd-yy'), \r",
				"    toDate(discharge_date, 'dd-MMM-yyyy'), \r",
				"    toDate(discharge_date, 'yyyy-MM-dd'),\r",
				"    toDate(discharge_date, 'MM/dd/yyyy'),\r",
				"    toDate(discharge_date, 'MMMM dd, yyyy'),\r",
				"    toDate('1900-01-01')\r",
				")) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          admission_id,",
				"          patient_id,",
				"          admission_date,",
				"          discharge_date,",
				"          department,",
				"          attending_doctor_id",
				"     )) ~> sink1"
			]
		}
	}
}