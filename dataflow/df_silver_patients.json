{
	"name": "df_silver_patients",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_patients_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_patients_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(gender = iif(in(['m', 'male', 'M', 'MALE'], lower(gender)), 'Male', iif(in(['f', 'female', 'F', 'FEMALE'], lower(gender)), 'Female', 'Unknown')),",
				"          phone = regex_replace(phone, '[^0-9]', ''),",
				"          email = lower(trim(replace(email, ',', '.'))),",
				"          full_name = trim(full_name),",
				"          patient_id = toInteger(patient_id)) ~> derivedColumn1",
				"derivedColumn1 derive(date_of_birth = toDate(date_of_birth, 'MMMM dd, yyyy')) ~> derivedColumn2",
				"derivedColumn2 derive(insurance_provider = iif(isNull(insurance_provider), 'Unknown',\r",
				"    case(\r",
				"        rlike(lower(insurance_provider), '.*blue.*'), 'BlueCross',\r",
				"        rlike(lower(insurance_provider), '.*aetna.*'), 'Aetna',\r",
				"        rlike(lower(insurance_provider), '.*cigna.*'), 'Cigna',\r",
				"        rlike(lower(insurance_provider), '.*united.*|^uhc$'), 'UnitedHealth',\r",
				"        rlike(lower(insurance_provider), '.*medicaid.*'), 'Medicaid',\r",
				"        rlike(lower(insurance_provider), '.*medicare.*|.*medi-care.*'), 'Medicare',\r",
				"        rlike(lower(insurance_provider), '.*self.*'), 'Self-Pay',\r",
				"        initCap(trim(insurance_provider))\r",
				"    )\r",
				")) ~> derivedColumn3",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id,",
				"          full_name,",
				"          gender,",
				"          date_of_birth,",
				"          phone,",
				"          email,",
				"          address,",
				"          insurance_provider",
				"     )) ~> sink1"
			]
		}
	}
}