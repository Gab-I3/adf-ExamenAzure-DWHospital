{
	"name": "df_gold_dim_departamento",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "silver_admissions_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "gold_dim_departamento_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 aggregate(groupBy(department),",
				"     conteo = count(1)) ~> aggregate1",
				"aggregate1 derive(department = case(\r",
				"    upper(department) == 'CARDIOLOGY', 'Cardiología',\r",
				"    upper(department) == 'NEUROLOGY', 'Neurología',\r",
				"    upper(department) == 'ONCOLOGY', 'Oncología',\r",
				"    upper(department) == 'PEDIATRICS', 'Pediatría',\r",
				"    upper(department) == 'EMERGENCY', 'Emergencias',\r",
				"    upper(department) == 'SURGERY', 'Cirugía',\r",
				"    upper(department) == 'ORTHOPEDICS', 'Ortopedia',\r",
				"    upper(department) == 'GYNECOLOGY', 'Ginecología',\r",
				"    upper(department) == 'INTENSIVE CARE' || upper(department) == 'ICU', 'Cuidados Intensivos',\r",
				"    upper(department) == 'GENERAL SURGERY', 'Cirugia General',\r",
				"    upper(department) == 'RADIOLOGY', 'Radiología',\r",
				"    department\r",
				")) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          departamento_key as integer,",
				"          nombre_departamento as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          nombre_departamento = department",
				"     )) ~> sink1"
			]
		}
	}
}