{
	"name": "df_gold_dim_servicio_cargo",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "silver_billing_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "gold_dim_servicio_cargo_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 aggregate(groupBy(charge_type,",
				"          payment_status),",
				"     conteo = count(1)) ~> aggregate1",
				"aggregate1 derive(charge_type = case(\r",
				"    upper(charge_type) == 'SURGERY', 'Cirugía',\r",
				"    upper(charge_type) == 'MEDICATION', 'Medicamentos',\r",
				"    upper(charge_type) == 'IMAGING', 'Imágenes Médicas',\r",
				"    upper(charge_type) == 'CONSULTATION', 'Consulta',\r",
				"    upper(charge_type) == 'LABORATORY', 'Laboratorio',\r",
				"    upper(charge_type) == 'ROOM', 'Habitación',\r",
				"    charge_type\r",
				"),",
				"          payment_status = case(\r",
				"    upper(payment_status) == 'PAID', 'Pagado',\r",
				"    upper(payment_status) == 'UNPAID', 'No Pagado',\r",
				"    upper(payment_status) == 'PENDING', 'Pendiente',\r",
				"    payment_status\r",
				")) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          servicio_cargo_key as integer,",
				"          tipo_cargo as string,",
				"          estado_pago as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          tipo_cargo = charge_type,",
				"          estado_pago = payment_status",
				"     )) ~> sink1"
			]
		}
	}
}